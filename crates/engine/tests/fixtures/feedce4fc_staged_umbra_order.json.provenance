Infrastructure exception: the Auras are attached with
engine::game::effects::attach::attach_to instead of being cast; the
destruction population is produced by the public cast of Day of Judgment.

Generator source:

//! Scratch generator for #10637's frozen pre-scheduler fixtures. Not for commit.
//! Run on a clean worktree of feedce4fc as
//! crates/engine/tests/integration/zz_feedce4fc_fixture_gen.rs with a matching
//! `mod zz_feedce4fc_fixture_gen;` line in shard_5.rs.
use engine::game::scenario::{GameRunner, GameScenario, P0, P1};
use engine::types::actions::GameAction;
use engine::types::game_state::{PersistedGameState, WaitingFor};
use engine::types::mana::ManaCost;
use engine::types::phase::Phase;

const DAY_OF_JUDGMENT: &str = "Destroy all creatures.";
const HYENA_UMBRA: &str = "Enchant creature\nEnchanted creature gets +1/+1 and has first strike.\nUmbra armor (If enchanted creature would be destroyed, instead remove all damage from it and destroy this Aura.)";
const SPIDER_UMBRA: &str = "Enchant creature\nEnchanted creature gets +1/+1 and has reach. (It can block creatures with flying.)\nUmbra armor (If enchanted creature would be destroyed, instead remove all damage from it and destroy this Aura.)";
const DAUTHI_VOIDWALKER: &str = "Shadow (This creature can block or be blocked by only creatures with shadow.)\nIf a card would be put into an opponent's graveyard from anywhere, instead exile it with a void counter on it.\n{T}, Sacrifice this creature: Choose an exiled card an opponent owns with a void counter on it. You may play it this turn without paying its mana cost.";
const REST_IN_PEACE: &str = "When this enchantment enters, exile all graveyards.\nIf a card or token would be put into a graveyard from anywhere, exile it instead.";

fn write(name: &str, runner: &mut GameRunner) {
    runner.state_mut().capture_rng_word_pos();
    let json = serde_json::to_string_pretty(&PersistedGameState::capture(runner.state().clone())).unwrap();
    let dir = std::env::var("FIXTURE_DIR").unwrap();
    let path = format!("{dir}/{name}");
    std::fs::write(&path, format!("{json}\n")).unwrap();
    eprintln!("GEN[{name}] written ({} bytes) waiting={:?}", json.len() + 1, runner.state().waiting_for);
    for frame in runner.state().resolution_stack.iter() {
        if let engine::types::resolution::ResolutionFrame::BatchDelivery(batch) = frame {
            let staged = batch.staged.as_ref().unwrap();
            eprintln!(
                "GEN[{name}] cursor={} paused={:?} members={:?}",
                staged.cursor,
                batch.paused_current.as_ref().map(|paused| paused.member.object_id),
                staged.members.iter().map(|m| (m.identity.object_id, m.state)).collect::<Vec<_>>()
            );
        }
    }
}

fn cast(runner: &mut GameRunner, spell: engine::types::identifiers::ObjectId) {
    runner.cast(spell).commit();
    for _ in 0..8 {
        if !matches!(runner.state().waiting_for, WaitingFor::Priority { .. }) {
            return;
        }
        runner.act(GameAction::PassPriority).unwrap();
    }
}

#[test]
fn generate_feedce4fc_fixtures() {
    // Own decision: P1's Grizzly Bears wears Hyena Umbra and Spider Umbra.
    {
        let mut scenario = GameScenario::new();
        scenario.at_phase(Phase::PreCombatMain);
        let bears = scenario.add_creature(P1, "Grizzly Bears", 2, 2).id();
        let hyena = scenario.add_enchantment_from_oracle(P1, "Hyena Umbra", HYENA_UMBRA).with_subtypes(vec!["Aura"]).id();
        let spider = scenario.add_enchantment_from_oracle(P1, "Spider Umbra", SPIDER_UMBRA).with_subtypes(vec!["Aura"]).id();
        let runeclaw = scenario.add_creature(P0, "Runeclaw Bear", 2, 2).id();
        let spell = scenario.add_spell_to_hand_from_oracle(P0, "Day of Judgment", false, DAY_OF_JUDGMENT).with_mana_cost(ManaCost::zero()).id();
        let mut runner = scenario.build();
        engine::game::effects::attach::attach_to(runner.state_mut(), hyena, bears);
        engine::game::effects::attach::attach_to(runner.state_mut(), spider, bears);
        engine::game::layers::flush_layers(runner.state_mut());
        cast(&mut runner, spell);
        eprintln!("GEN[own] ids bears={bears:?} hyena={hyena:?} spider={spider:?} runeclaw={runeclaw:?} spell={spell:?}");
        write("feedce4fc_staged_umbra_order.json", &mut runner);
    }
    // Live child: P0 controls Dauthi Voidwalker and Rest in Peace; P1's Grizzly
    // Bears wears P1's Hyena Umbra.
    {
        let mut scenario = GameScenario::new();
        scenario.at_phase(Phase::PreCombatMain);
        let bears = scenario.add_creature(P1, "Grizzly Bears", 2, 2).id();
        let hyena = scenario.add_enchantment_from_oracle(P1, "Hyena Umbra", HYENA_UMBRA).with_subtypes(vec!["Aura"]).id();
        let dauthi = scenario.add_creature_from_oracle(P0, "Dauthi Voidwalker", 3, 2, DAUTHI_VOIDWALKER).id();
        let peace = scenario.add_enchantment_from_oracle(P0, "Rest in Peace", REST_IN_PEACE).id();
        let spell = scenario.add_spell_to_hand_from_oracle(P0, "Day of Judgment", false, DAY_OF_JUDGMENT).with_mana_cost(ManaCost::zero()).id();
        let mut runner = scenario.build();
        engine::game::effects::attach::attach_to(runner.state_mut(), hyena, bears);
        engine::game::layers::flush_layers(runner.state_mut());
        cast(&mut runner, spell);
        eprintln!("GEN[child] ids bears={bears:?} hyena={hyena:?} dauthi={dauthi:?} peace={peace:?} spell={spell:?}");
        write("feedce4fc_staged_umbra_live_child.json", &mut runner);
    }
}
