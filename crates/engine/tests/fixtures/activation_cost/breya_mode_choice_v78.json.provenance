Frozen v78 fixture for #9248 RT-2 (legacy fidelity of a paused AbilityModeChoice).

Generated by the OLD serializer. Never regenerate it with a newer engine: its
value is that it is byte-for-byte what a protocol-78 engine wrote.

Generating commit: 1bf20245091305d2bfaf57e56ffaa3fd0946d61c
  (upstream phase-rs/phase, lobby-broker PROTOCOL_VERSION = 78; the merge-base
  of jeffyw-professor-hojo at d5f45c8c1)

Serializer: PersistedGameState::capture(state) after state.capture_rng_word_pos(),
  i.e. the trusted envelope that engine-wasm's export_game_state_json writes,
  pretty-printed with serde_json::to_string_pretty plus a trailing newline.

Command (PowerShell, in a worktree checked out at the commit above, with the
generator below added as crates/engine/tests/integration/zz_v78_fixture_gen.rs
and a matching mod zz_v78_fixture_gen; line in main.rs):

  $env:FIXTURE_OUT = '<repo>\crates\engine\tests\fixtures\activation_cost\breya_mode_choice_v78.json'
  cargo nextest run -p phase-engine --test integration generate_breya_mode_choice_v78 --no-capture

Observed on that run:
  V78 CONTROL paid 1
  V78 ability_cost at AbilityModeChoice: Composite [Mana {generic: 1}, Sacrifice 2 artifacts]
  waiting_for.data keys: ability_cost, ability_index, is_activated, modal,
    mode_abilities, player, source_id  (no activation-cost carrier key;
    unavailable_modes is omitted when empty)

Board: Breya, Etherium Shaper (printed {2}, Sacrifice two artifacts) and an
unfloored "Activated abilities of creatures you control cost {1} less to
activate." for P0, two sacrificable artifacts, a 5/5 Bear for P1, eight blue
mana. Paused after ActivateAbility { Breya, 0 }. v78 folded the reduction at
announcement, so ability_cost's generic is already 1.

Generator source:

//! Scratch generator for #9248 RT-2's frozen v78 fixture. Not for commit.

use engine::game::scenario::{GameRunner, GameScenario, P0, P1};
use engine::types::actions::GameAction;
use engine::types::game_state::{PersistedGameState, WaitingFor};
use engine::types::identifiers::ObjectId;
use engine::types::mana::{ManaColor, ManaUnit};
use engine::types::phase::Phase;

const BREYA: &str = "When Breya enters, create two 1/1 blue Thopter artifact creature tokens with flying.\n{2}, Sacrifice two artifacts: Choose one \u{2014}\n\u{2022} Breya deals 3 damage to target player or planeswalker.\n\u{2022} Target creature gets -4/-4 until end of turn.\n\u{2022} You gain 5 life.";
const REDUCER: &str = "Activated abilities of creatures you control cost {1} less to activate.";

fn board() -> (GameRunner, ObjectId, ObjectId, ObjectId, ObjectId) {
    let mut s = GameScenario::new();
    s.at_phase(Phase::PreCombatMain);
    s.add_artifact_from_oracle(P0, "Unfloored Reducer", REDUCER);
    let breya = s
        .add_creature_from_oracle(P0, "Breya, Etherium Shaper", 4, 4, BREYA)
        .id();
    let a1 = s
        .add_artifact_from_oracle(P0, "Bauble A", "{T}: You gain 1 life.")
        .id();
    let a2 = s
        .add_artifact_from_oracle(P0, "Bauble B", "{T}: You gain 1 life.")
        .id();
    let bear = s.add_creature(P1, "Bear", 5, 5).id();
    s.with_mana_pool(
        P0,
        (0..8)
            .map(|_| ManaUnit::new(ManaColor::Blue.into(), ObjectId(0), false, Vec::new()))
            .collect(),
    );
    let mut r = s.build();
    r.state_mut()
        .objects
        .get_mut(&breya)
        .unwrap()
        .has_summoning_sickness = false;
    (r, breya, a1, a2, bear)
}

fn pool(r: &GameRunner) -> usize {
    r.state().players[0].mana_pool.total()
}

#[test]
fn generate_breya_mode_choice_v78() {
    // Control on v78: the full flow pays 1 (the {1}-less reducer folds once).
    let (mut c, cb, ca1, ca2, cbear) = board();
    let before = pool(&c);
    c.activate(cb, 0)
        .modes(&[1])
        .pay_with(&[ca1, ca2])
        .target_object(cbear)
        .resolve();
    let control_paid = before - pool(&c);
    println!("V78 CONTROL paid {control_paid}");
    assert_eq!(control_paid, 1);

    let (mut r, breya, _, _, _) = board();
    r.act(GameAction::ActivateAbility {
        source_id: breya,
        ability_index: 0,
    })
    .expect("activation starts");
    match &r.state().waiting_for {
        WaitingFor::AbilityModeChoice { ability_cost, .. } => {
            println!("V78 ability_cost at AbilityModeChoice: {ability_cost:?}");
        }
        other => panic!("expected AbilityModeChoice, got {other:?}"),
    }
    let state = r.state_mut();
    state.capture_rng_word_pos();
    let json = serde_json::to_string_pretty(&PersistedGameState::capture(state.clone()))
        .expect("state serializes");
    let out = std::env::var("FIXTURE_OUT").expect("FIXTURE_OUT set");
    std::fs::write(&out, format!("{json}\n")).expect("fixture written");
    println!("V78 FIXTURE written to {out} ({} bytes)", json.len() + 1);
}
