  "scoring_model": {
    "mode": "additive",
    "formula": "base_card_rating + set_class_bonus + card_bonus + archetype_synergy + deck_need_bonus + draft_signal_bonus",
    "note": "Every configured value is an incremental bonus, not a replacement for the base card rating. Do not apply the same mechanic twice through duplicate tags. Card bonuses are deliberately selective: the base rating should handle ordinary playables."
  },
  "adaptive_draft_policy": {
    "mode": "adaptive",
    "pack_order": [
      "CHK",
      "BOK",
      "SOK"
    ],
    "draft_stages": {
      "early": {
        "pick_range": [
          1,
          5
        ],
        "raw_power_weight": 1.0,
        "deck_fit_weight": 0.2,
        "color_commitment": "very_low"
      },
      "middle": {
        "pick_range": [
          6,
          9
        ],
        "raw_power_weight": 0.8,
        "deck_fit_weight": 0.7,
        "color_commitment": "low"
      },
      "late": {
        "pick_range": [
          10,
          15
        ],
        "raw_power_weight": 0.6,
        "deck_fit_weight": 1.0,
        "color_commitment": "moderate"
      }
    },
    "archetype_detection": {
      "minimum_signals": 3,
      "signals": "Count distinct quality enablers/payoffs and functional synergies, not raw card count. A single powerful card should not lock the draft into a lane.",
      "supported_themes": [
        "red_green_spirits_arcane",
        "white_black_spirits_soulshift",
        "blue_black_ninjas_tempo",
        "blue_white_evasion_tempo",
        "red_black_aggression",
        "green_midrange_spirits",
        "arcane_splice_control",
        "five_color_goodstuff"
      ],
      "behavior": "Track multiple themes simultaneously. Reassess after each pick and each pack transition; do not force an archetype from one signal."
    },
    "deck_fit": {
      "consider": [
        "mana_curve",
        "colored_mana_requirements",
        "removal",
        "evasion",
        "creature_count",
        "threat_quality",
        "card_advantage",
        "spirit_count",
        "arcane_count",
        "soulshift_chain",
        "splice_targets",
        "ninjutsu_enablers",
        "ninja_payoffs",
        "combat_tricks",
        "mana_fixing"
      ],
      "color_policy": "No fixed color preference. Penalize off-color cards only as commitment increases; use signals from both card quality and likely open colors.",
      "splash_policy": "Splash only high-impact cards or premium removal when fixing and mana costs support it. Avoid splashing double-pip cards or weakening early plays."
    },
    "deck_need_bonus": {
      "enabled": true,
      "maximum_per_card": 2.0,
      "note": "Use diminishing returns. Prioritize enough early plays, interaction, evasion, and real finishers. Do not award repeated bonus for simply accumulating Spirits or Arcane cards once the deck has sufficient density."
    },
    "archetype_synergy_bonus": {
      "enabled": true,
      "maximum_per_card": 2.5,
      "note": "Apply only when the pool demonstrates the relevant theme. Synergy is incremental and must not duplicate set_class_bonus or card_bonus. Strongest recurring patterns include Spirit/Arcane/Soulshift, Ninja/evasion, and tempo/evasion."
    },
    "color_commitment": {
      "early_picks": 0.0,
      "middle_picks": 0.5,
      "late_picks": 1.0,
      "note": "These are maximum penalty multipliers, not flat card penalties; actual penalty should scale with colored mana cost and current color concentration."
    }
  }
}
